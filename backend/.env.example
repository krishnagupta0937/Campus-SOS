# Application
NODE_ENV=development
APP_ENV=development
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://campus_sos_app:secret@localhost:5432/campus_sos?schema=public

# Redis & Queues (BullMQ)
REDIS_URL=redis://localhost:6379

# JWT & Authentication
JWT_ACCESS_SECRET=campus-sos-dev-access-secret-key-32chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=campus-sos-dev-refresh-secret-key-32chars
JWT_REFRESH_EXPIRY=7d
COOKIE_SECRET=campus-sos-dev-cookie-signing-secret

# Object Storage (S3 / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_NAME=campus-sos-attachments
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# AI Provider (rule / gemini / openai)
AI_PROVIDER=gemini
AI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
AI_TIMEOUT_SOS_MS=4000
AI_TIMEOUT_STANDARD_MS=8000

# Push Notifications (Web Push / VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@campussos.edu

# SMS / Voice Gateway (mock / twilio)
SMS_GATEWAY_PROVIDER=mock
SMS_API_KEY=
VOICE_GATEWAY_PROVIDER=mock
VOICE_API_KEY=
